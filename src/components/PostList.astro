---
import PixelIcon from './PixelIcon.astro';
import { LANTERN, HAMMER, ARROW } from '../lib/sprites';
import { formatDate, postUrl, tagUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** Show the series order instead of the date. */
  seriesMode?: boolean;
}
const { posts, seriesMode = false } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty pixel px-12">篝火刚生起来，第一篇文章还在路上。</p>
  ) : (
    <ol class="post-list">
      {posts.map((post) => (
        <li class="item" data-kind={post.data.kind}>
          <div class="meta pixel px-12">
            {seriesMode ? (
              <span>第 {post.data.seriesOrder ?? '?'} 关</span>
            ) : (
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            )}
          </div>
          <div class="body">
            <a href={postUrl(post)} class="title-link">
              <span class="arrow" aria-hidden="true">
                <PixelIcon sprite={ARROW} scale={3} />
              </span>
              <h3 class="title px-24">
                {post.data.title}
                {post.data.draft && <span class="chip draft">草稿</span>}
              </h3>
            </a>
            <p class="desc">{post.data.description}</p>
            <p class="tags">
              <span class="kind pixel px-12" title={post.data.kind}>
                <PixelIcon sprite={post.data.kind === '感悟' ? LANTERN : HAMMER} scale={2} />
                {post.data.kind}
              </span>
              {post.data.tags.map((t) => (
                <a class="chip" href={tagUrl(t)}>
                  {t}
                </a>
              ))}
            </p>
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    display: grid;
    gap: 4px 32px;
    padding: 28px 0;
    border-bottom: 2px dashed var(--bg-3);
  }
  .item:last-child {
    border-bottom: 0;
  }
  @media (min-width: 720px) {
    .item {
      grid-template-columns: 120px 1fr;
    }
  }
  .meta {
    color: var(--muted);
    padding-top: 8px;
  }
  .title-link {
    position: relative;
    display: block;
  }
  .arrow {
    position: absolute;
    left: -24px;
    top: 8px;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 120ms steps(2),
      transform 160ms steps(3);
    --sp-outline: var(--accent);
  }
  .title {
    margin: 0;
    color: var(--ink);
  }
  .title-link:hover .title {
    color: var(--accent);
  }
  .title-link:hover .arrow,
  .title-link:focus-visible .arrow {
    opacity: 1;
    transform: none;
  }
  .draft {
    margin-left: 8px;
    vertical-align: middle;
    color: var(--accent);
  }
  .desc {
    margin: 8px 0 12px;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.8;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
  }
  .kind {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
  }
  .empty {
    padding: 48px 0;
    color: var(--muted);
    text-align: center;
  }
  .item[hidden] {
    display: none;
  }
</style>
