---
import 'katex/dist/katex.min.css';
import '../../styles/prose.css';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PixelIcon from '../../components/PixelIcon.astro';
import { LANTERN, HAMMER } from '../../lib/sprites';
import { getPosts, formatDate, postUrl, tagUrl, readingMinutes, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], all: posts },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  all: Post[];
}

const { post, newer, older, all } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const series = d.series ? await getEntry(d.series) : undefined;
const seriesPosts = series
  ? all.filter((p) => p.data.series?.id === series.id).sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
---

<Base title={d.title} description={d.description}>
  <div class="hp" aria-hidden="true"><div class="hp-fill"></div></div>

  <article class="wrap post">
    <header class="post-head">
      <p class="meta pixel px-12">
        <a class="kind" href={`/posts/?kind=${encodeURIComponent(d.kind)}`}>
          <PixelIcon sprite={d.kind === '感悟' ? LANTERN : HAMMER} scale={2} />
          {d.kind}
        </a>
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        <span>约 {readingMinutes(post.body)} 分钟</span>
        {d.draft && <span class="chip draft">草稿 · 不会发布</span>}
      </p>
      <h1 class="px-36 title" data-pagefind-meta="title">{d.title}</h1>
      <p class="lede">{d.description}</p>
      {
        series && (
          <p class="series-tag pixel px-12">
            <a class="px-link" href={`/series/${series.id}/`}>
              {series.data.title}
            </a>
            <span> · 第 {d.seriesOrder ?? '?'} 关 / 共 {seriesPosts.length} 关</span>
          </p>
        )
      }
    </header>

    <div class="prose" data-pagefind-body>
      <Content />
    </div>

    <footer class="post-foot">
      {
        d.updated && (
          <p class="pixel px-12 muted">最后修订于 {formatDate(d.updated)}</p>
        )
      }
      {
        d.tags.length > 0 && (
          <p class="tags">
            {d.tags.map((t) => (
              <a class="chip" href={tagUrl(t)}>
                #{t}
              </a>
            ))}
          </p>
        )
      }

      {
        series && seriesPosts.length > 1 && (
          <nav class="series-box px-frame" aria-label="本系列">
            <p class="kicker">关卡 · {series.data.title}</p>
            <ol>
              {seriesPosts.map((p) => (
                <li class:list={{ current: p.id === post.id }}>
                  {p.id === post.id ? (
                    <span>{p.data.title}</span>
                  ) : (
                    <a class="px-link" href={postUrl(p)}>
                      {p.data.title}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <nav class="pager" aria-label="上一篇与下一篇">
        {
          newer ? (
            <a class="px-frame pager-card" href={postUrl(newer)}>
              <span class="pixel px-12 muted">← 较新</span>
              <span>{newer.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          older && (
            <a class="px-frame pager-card right" href={postUrl(older)}>
              <span class="pixel px-12 muted">较早 →</span>
              <span>{older.data.title}</span>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</Base>

<script>
  // Reading progress as a segmented "stamina" bar.
  const fill = document.querySelector<HTMLElement>('.hp-fill');
  const article = document.querySelector<HTMLElement>('.post');
  if (fill && article) {
    const update = () => {
      const r = article.getBoundingClientRect();
      const total = r.height - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      // snap to whole segments (12px each)
      const seg = 12;
      const w = Math.round((p * innerWidth) / seg) * seg;
      fill.style.width = `${w}px`;
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .hp {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 8px;
    background: var(--bg-2);
    box-shadow: 0 2px 0 0 var(--line);
  }
  .hp-fill {
    height: 100%;
    width: 0;
    background: repeating-linear-gradient(90deg, var(--accent) 0 10px, transparent 10px 12px);
  }
  .post {
    padding-top: 72px;
    max-width: calc(var(--measure) + 64px);
  }
  .post-head {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: var(--px) solid var(--line);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin: 0 0 16px;
    color: var(--muted);
  }
  .kind {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
  }
  .draft {
    color: var(--accent);
  }
  .title {
    margin: 0 0 16px;
  }
  @media (max-width: 600px) {
    .title {
      font-size: 24px;
    }
  }
  .lede {
    margin: 0;
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .series-tag {
    margin: 16px 0 0;
    color: var(--muted);
  }
  .post-foot {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .post-foot > p {
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .series-box {
    padding: 20px 24px;
  }
  .series-box ol {
    margin: 0;
    padding-left: 1.6em;
  }
  .series-box li::marker {
    font-family: var(--font-pixel);
    font-size: 12px;
    color: var(--muted);
  }
  .series-box .current {
    color: var(--accent);
  }
  .series-box .current::marker {
    content: '▶ ';
    color: var(--accent);
  }
  .pager {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pager-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px;
  }
  .pager-card:hover {
    color: var(--accent);
  }
  .pager-card.right {
    text-align: right;
  }
</style>
